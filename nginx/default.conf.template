server {
    listen ${PORT};

    # Unauthenticated health check for platform probes (Railway/Render/Docker HEALTHCHECK).
    location /healthz {
        proxy_pass http://127.0.0.1:8000/healthz;
    }

    # OAuth 2.1 discovery / DCR / authorize / token endpoints, served by the
    # oauth-shim process. These must see the real public Host (not the
    # internal upstream address) so they can build correct absolute URLs.
    location ~ ^/(\.well-known/oauth-protected-resource|\.well-known/oauth-authorization-server|register|authorize|token)$ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Everything else — including the MCP endpoint — requires the bearer token.
    # The upstream garmin-mcp process only listens on 127.0.0.1 inside this
    # container, so it is never reachable except through this check.
    #
    # Accepted two ways: "Authorization: Bearer <token>" header (what the
    # OAuth token endpoint above hands out, and what claude.ai will send
    # after completing the OAuth flow), or a "?token=<token>" query param
    # for manual/non-OAuth clients.
    location / {
        set $auth_ok 0;
        if ($http_authorization = "Bearer ${MCP_BEARER_TOKEN}") {
            set $auth_ok 1;
        }
        if ($arg_token = "${MCP_BEARER_TOKEN}") {
            set $auth_ok 1;
        }
        if ($auth_ok = 0) {
            add_header WWW-Authenticate 'Bearer resource_metadata="https://$host/.well-known/oauth-protected-resource"' always;
            return 401;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # The upstream MCP server validates the Host header (DNS-rebinding
        # protection) against its own bind address — not the public Host
        # the client sent — so it must be overridden here, not passed through.
        proxy_set_header Host 127.0.0.1:8000;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
