# --- Garmin Connect credentials ---
# Only needed for the one-time interactive `garmin-mcp-auth` step (handles MFA).
# After that, OAuth tokens are cached in the garmin-tokens volume and these
# are no longer read at runtime: delete GARMIN_PASSWORD from this file right after
# the auth step, so the password does not sit on disk or in the container env.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# --- Access control ---
# Secret required in the "Authorization: Bearer <token>" header to reach the
# MCP server. Anyone with this token has full access to your Garmin data —
# treat it like a password. Generate one with:
#   openssl rand -hex 32
MCP_BEARER_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# Secret you type on the consent page when connecting a client (claude.ai).
# MUST differ from MCP_BEARER_TOKEN, at least 16 characters; the container
# refuses to start otherwise. Rotating it revokes every refresh token.
#   openssl rand -hex 24
MCP_CONSENT_SECRET=REPLACE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET

# Optional: comma-separated exact redirect URIs the consent page may send the
# user back to. Defaults to claude.ai's MCP callback.
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Optional: public URL of this server (e.g. https://mcp.example.com). When set,
# OAuth metadata uses it instead of trusting the request's Host header.
# PUBLIC_BASE_URL=https://mcp.example.com

# --- Networking ---
# Port nginx listens on / publishes. Railway and Render inject their own
# PORT automatically and override this.
PORT=8080
